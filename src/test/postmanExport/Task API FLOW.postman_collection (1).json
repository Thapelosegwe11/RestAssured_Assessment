  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Message returns string\", function () {",
                  "    pm.expect(pm.response.text()).to.include(\"Login successful\");",
                  "});",
                  "",
                  "pm.test(\"Verify user role\", function () {",
                  "    let response = pm.response.json();",
                  "    pm.expect(pm.response.text()).to.include(\"admin\");",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "",
                  "",
                  "// Convert Response to json",
                  "",
                  "let response = pm.response.json();",
                  "",
                  "// Extract token.",
                  "",
                  "let token = response.data.token;",
                  "",
                  "// Set tokenin environment variable.",
                  "",
                  "pm.environment.set(\"token\", token);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "",
                "value": "",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n  \"email\": \"segwe.bz@gmail.com\",\r\n  \"password\": \"rA!ny@$14\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
