        {
          "name": "GetTaskCompletions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Response has success flag\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "",
                  "pm.test(\"Response contains task and completions data\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('task');",
                  "    pm.expect(jsonData.data).to.have.property('completions');",
                  "    pm.expect(jsonData.data.completions).to.be.an('array');",
                  "});",
                  "",
                  "pm.test(\"Response contains stats\", function () {",
                  "    const jsonData = pm.response.json();",
                  "    pm.expect(jsonData.data).to.have.property('stats');",
                  "    pm.expect(jsonData.data.stats).to.have.property('totalAssigned');",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
